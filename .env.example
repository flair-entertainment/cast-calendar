# Copy this file to .env.local and fill in the values (never commit .env.local).
# Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret. Server only. Never put this in the browser or in git.
SUPABASE_SERVICE_ROLE_KEY=
# The live website address, e.g. https://cast-calendar.vercel.app (http://localhost:3000 on your computer)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# The join code performers need to sign themselves up. Share it in the performer group chat.
# Change it (in Vercel, then redeploy) if it gets passed round outside Flair.
SIGNUP_CODE=
